# Copy to .env (gitignored) to override. Nothing here is a secret — it's
# a purely local stack — but .env stays untracked so nobody accidentally
# commits a personal override.

POSTGRES_USER=dock
POSTGRES_PASSWORD=dockpw
POSTGRES_DB=dock

# Host port for Postgres (change if something else already uses 5432).
DB_PORT=5432

# Opt-in local synthetic data: when set to 1, the api container runs a
# seed step after migrating (a few episodes' worth of orders/events,
# generated by the real simulator — never committed to the repo, never
# shipped to anyone who pulls without setting this themselves).
DOCK_SEED=0

# PPO checkpoint override; default picks the newest runs/ppo_c<N>/model.zip.
# DOCK_PPO_MODEL=runs/ppo_c5/model.zip

# Live simulation pace in sim-days per wall-clock second (default 1/60 =
# 1 sim-day per minute). Faster makes the operator views livelier, but
# sailings leave sooner, so customer quotes go stale faster.
# scripts/e2e.sh is meant to run with something like 0.5.
# DOCK_LIVE_SPEED=0.5

# LLM chat assistant (customer dashboard + operator stowage screen). Any
# OpenAI-compatible endpoint; the key is only ever read by the api service.
# Leave LLM_API_KEY empty to disable the chat (the widgets say so).
LLM_BASE_URL=https://api.voidai.app/v1
LLM_API_KEY=
LLM_MODEL=gpt-5.6-luna
