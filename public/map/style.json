{
  "version": 8,
  "name": "Dock Abyss",
  "metadata": {
    "dock:description": "Fully local dark basemap for Dock fleet positions (Protomaps/OSM tiles, z0-6)."
  },
  "sources": {
    "protomaps": {
      "type": "vector",
      "tiles": ["/map/tiles/{z}/{x}/{y}.mvt"],
      "minzoom": 0,
      "maxzoom": 6,
      "bounds": [-140, -10, 165, 68],
      "attribution": "© Protomaps © OpenStreetMap contributors"
    }
  },
  "glyphs": "/map/fonts/{fontstack}/{range}.pbf",
  "sprite": "/map/sprites/dark",
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": { "background-color": "#060a20" }
    },
    {
      "id": "earth",
      "type": "fill",
      "source": "protomaps",
      "source-layer": "earth",
      "filter": ["==", "$type", "Polygon"],
      "paint": { "fill-color": "#0b1130" }
    },
    {
      "id": "landcover",
      "type": "fill",
      "source": "protomaps",
      "source-layer": "landcover",
      "paint": { "fill-color": "#0e1536", "fill-opacity": 0.6 }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "protomaps",
      "source-layer": "water",
      "filter": ["==", "$type", "Polygon"],
      "paint": { "fill-color": "#060a20" }
    },
    {
      "id": "boundaries",
      "type": "line",
      "source": "protomaps",
      "source-layer": "boundaries",
      "filter": [">", "kind_detail", 2],
      "paint": {
        "line-color": "#262e63",
        "line-width": 0.4,
        "line-opacity": 0.35
      }
    },
    {
      "id": "boundaries_country",
      "type": "line",
      "source": "protomaps",
      "source-layer": "boundaries",
      "filter": ["<=", "kind_detail", 2],
      "paint": {
        "line-color": "#262e63",
        "line-width": [
          "interpolate", ["linear"], ["zoom"],
          0, 0.5,
          4, 0.8,
          6, 1.1
        ],
        "line-opacity": 0.55
      }
    },
    {
      "id": "water_label_lakes",
      "type": "symbol",
      "source": "protomaps",
      "source-layer": "water",
      "filter": ["in", "kind", "lake", "water"],
      "layout": {
        "text-font": ["Noto Sans Italic"],
        "text-field": ["coalesce", ["get", "name:en"], ["get", "name"]],
        "text-size": ["interpolate", ["linear"], ["zoom"], 2, 9, 6, 11],
        "text-letter-spacing": 0.08,
        "text-max-width": 6
      },
      "paint": {
        "text-color": "#4b5180",
        "text-halo-color": "#060a20",
        "text-halo-width": 1
      }
    },
    {
      "id": "water_label_ocean",
      "type": "symbol",
      "source": "protomaps",
      "source-layer": "water",
      "filter": ["in", "kind", "sea", "ocean", "bay", "strait", "fjord"],
      "layout": {
        "text-font": ["Noto Sans Italic"],
        "text-field": ["coalesce", ["get", "name:en"], ["get", "name"]],
        "text-size": ["interpolate", ["linear"], ["zoom"], 0, 10, 4, 12, 6, 14],
        "text-letter-spacing": 0.14,
        "text-transform": "uppercase",
        "text-max-width": 8
      },
      "paint": {
        "text-color": "#4b5180",
        "text-halo-color": "#060a20",
        "text-halo-width": 1.2
      }
    },
    {
      "id": "earth_label_islands",
      "type": "symbol",
      "source": "protomaps",
      "source-layer": "earth",
      "filter": ["in", "kind", "island"],
      "layout": {
        "text-font": ["Noto Sans Regular"],
        "text-field": ["coalesce", ["get", "name:en"], ["get", "name"]],
        "text-size": ["interpolate", ["linear"], ["zoom"], 3, 8, 6, 10],
        "text-letter-spacing": 0.08
      },
      "paint": {
        "text-color": "#4b5180",
        "text-halo-color": "#0b1130",
        "text-halo-width": 1
      }
    },
    {
      "id": "places_region",
      "type": "symbol",
      "source": "protomaps",
      "source-layer": "places",
      "minzoom": 3,
      "filter": ["==", "kind", "region"],
      "layout": {
        "text-font": ["Noto Sans Regular"],
        "text-field": ["coalesce", ["get", "name:en"], ["get", "name"]],
        "text-size": ["interpolate", ["linear"], ["zoom"], 3, 9, 6, 11],
        "text-letter-spacing": 0.1,
        "text-transform": "uppercase",
        "text-max-width": 8,
        "symbol-sort-key": ["get", "min_zoom"]
      },
      "paint": {
        "text-color": "#6c739b",
        "text-opacity": 0.8,
        "text-halo-color": "#0b1130",
        "text-halo-width": 1
      }
    },
    {
      "id": "places_locality",
      "type": "symbol",
      "source": "protomaps",
      "source-layer": "places",
      "minzoom": 2,
      "filter": ["==", "kind", "locality"],
      "layout": {
        "text-font": ["Noto Sans Regular"],
        "text-field": ["coalesce", ["get", "name:en"], ["get", "name"]],
        "text-size": ["interpolate", ["linear"], ["zoom"], 2, 9, 4, 10, 6, 12],
        "text-letter-spacing": 0.06,
        "text-max-width": 8,
        "symbol-sort-key": ["get", "min_zoom"]
      },
      "paint": {
        "text-color": "#6c739b",
        "text-halo-color": "#0b1130",
        "text-halo-width": 1
      }
    },
    {
      "id": "places_country",
      "type": "symbol",
      "source": "protomaps",
      "source-layer": "places",
      "filter": ["==", "kind", "country"],
      "layout": {
        "text-font": ["Noto Sans Medium"],
        "text-field": ["coalesce", ["get", "name:en"], ["get", "name"]],
        "text-size": ["interpolate", ["linear"], ["zoom"], 1, 10, 4, 12, 6, 14],
        "text-letter-spacing": 0.16,
        "text-transform": "uppercase",
        "text-max-width": 9,
        "symbol-sort-key": ["get", "min_zoom"]
      },
      "paint": {
        "text-color": "#6c739b",
        "text-halo-color": "#0b1130",
        "text-halo-width": 1.2
      }
    }
  ]
}
